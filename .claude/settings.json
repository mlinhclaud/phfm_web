{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 src/build.py)",
      "Bash(node qa/*)",
      "Bash(bash scripts/setup.sh)",
      "Bash(gh issue *)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)"
    ]
  }
}
